# Copy to .env.local and edit. Never commit real keys.
# static | api | mock
VITE_FC_DATA_MODE=static
# static mode: "/data" (files in public/data) or the public bucket:
# VITE_FC_BASE=https://huggingface.co/buckets/Ploychomphoo/firecalendar-data/resolve
VITE_FC_BASE=/data
# api mode (phase 6, after the Space is deployed)
VITE_FIRECALENDAR_API=http://localhost:7860
# free NASA FIRMS key for raw hotspot CSV in static mode (visible in the browser)
VITE_FIRMS_MAP_KEY=
VITE_FC_FEATURE_ASK=false
# Firefighter alerts backend (docs/adr/ADR-016). Empty = demo: subscriptions stay in this browser, no email is sent.
VITE_FC_ALERTS_API=
# Main backend (Node). Set → firefighter watchpoints come from GET {this}/watchpoint
# response: { success: true, data: [{ name, country, region, lat, lon }] }
VITE_FC_BACKEND_API=
# watch radius (km) drawn around each backend watchpoint (they are bare points)
VITE_FC_WATCH_RADIUS_KM=25
# canopy height tiles (npm run canopy:build). Default /canopy (public/canopy); can point to a bucket with CORS
VITE_FC_CANOPY_BASE=/canopy
